# ILMU by YTL Labs — GLM-5.1
ILMU_API_KEY=replace-me
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=glm-5.1

# LangSmith tracing (free tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=orion-reimburse
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# App
APP_HOST=127.0.0.1
APP_PORT=8000
AUTO_APPROVE_LIMIT_MYR=500
ESCALATION_LIMIT_MYR=5000

# Security — API authentication
# Comma-separated list of valid API keys for the X-API-Key header.
# Use "dev-key" for local dev only. Generate strong random keys for production.
# Example: openssl rand -hex 32
ORION_API_KEYS=dev-key
